{
	"name": "egppneumatique",
	"version": "1.0.0",
	"scripts": {
		"postinstall": "node setup/sync-biome-schema.mjs",
		"build:shared": "npm run build -w shared",
		"build": "npm run build -ws --if-present",
		"start": "npm run start -w server",
		"tsc": "tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p web/tsconfig.json",
		"dev": "npm run build:shared && concurrently \"npm run dev -w web\" \"npm run dev -w server\"",
		"dev:web": "npm run build:shared && npm run dev -w web",
		"dev:server": "npm run build:shared && npm run dev -w server",
		"lint": "biome lint .",
		"fix": "biome lint --write . && biome format --write .",
		"format": "biome format --write .",
		"db:init": "npx tsx server/src/database/init-db.ts",
		"liveApp": "tsx setup/liveApp.ts"
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "latest",
		"@types/node": "latest",
		"concurrently": "latest",
		"dotenv": "latest",
		"tsx": "latest",
		"typescript": "latest"
	},
	"workspaces": [
		"web",
		"server",
		"mobile",
		"shared"
	]
}
